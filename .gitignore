# Rust build output
/target/
**/*.rs.bk

# OS/editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Node (vite dev server)
node_modules/
dist/

# Generated npm beta release artifacts
npm/permanent-underclass-darwin-arm64/bin/permanent-underclass
npm/permanent-underclass-darwin-arm64/data/sfx/
